# Generated builds and Projucer exports (regenerate from Fly.jucer)
/build/
/build-*/
/Builds/
/JuceLibraryCode/

# Local environments, downloaded inputs, agent state and historical cleanup tools
/.venv/
/.cache/
/.freebuff/
/Reports/local/

# Machine-specific configuration and credentials
.env
.env.*
!.env.example
.vs/
.idea/
*.user
*.suo

# Generated logs, Python bytecode and editor/OS debris
*.log
__pycache__/
*.py[cod]
*.bak
*.tmp
.DS_Store
Thumbs.db

# VST3 bundle internals — only track the bundle directory itself, not its generated internals
# (moduleinfo.json is regenerated by the build; the binary is the tracked artifact)
**/VST3/*/moduleinfo.json
**/*.vst3/*/moduleinfo.json
moduleinfo.json
